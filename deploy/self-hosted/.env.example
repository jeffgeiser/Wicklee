# Wicklee self-hosted control plane — copy to .env and fill in.
# Full guide: docs/SELF_HOSTING.md

# ── Required ──────────────────────────────────────────────────────────────────
# Postgres superuser password for the bundled database.
POSTGRES_PASSWORD=change-me

# ── Licensing ─────────────────────────────────────────────────────────────────
# Enterprise license key (sales@wicklee.dev). Without it the control plane
# runs in evaluation mode — fully functional, logged as unlicensed.
WICKLEE_LICENSE_KEY=

# ── Auth (bring your own Clerk application — free tier works) ────────────────
# Create an app at dashboard.clerk.com, then copy:
#   JWKS URL     → API Keys → Show JWKS URL
#   Secret key   → API Keys → Secret keys
#   Publishable  → API Keys → Publishable keys (baked into the frontend build)
CLERK_JWKS_URL=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# ── Optional integrations (features degrade gracefully when unset) ───────────
# Email alerts + weekly idle-waste digest (Resend).
RESEND_API_KEY=
FROM_EMAIL=
# Model Discovery catalog refresh (HuggingFace).
HUGGINGFACE_TOKEN=

# ── Networking ────────────────────────────────────────────────────────────────
# Host port the dashboard is published on.
WICKLEE_HTTP_PORT=8080
